        <script><![CDATA[(function executeRule(current, previous) {
    var assessmentId = current.getValue('assessment');

    if (!assessmentId) {
        gs.error('[SentinelOps Engine] - Cannot recalculate score: assessment reference is null on checklist_result ' + current.getUniqueValue());
        return;
    }

    try {
        var readiness_scorer = new x_1858206_sentin_0.ReadinessScorer();
        readiness_scorer.calculate(assessmentId);

        gs.info('[SentinelOps Engine] - Readiness score recalculated for assessment: ' + assessmentId + ' triggered by checklist_result: ' + current.getUniqueValue());
    } catch (ex) {
        gs.error('[SentinelOps Engine] - Failed to recalculate readiness score for assessment: ' + assessmentId + ' | Error: ' + ex.message);
    }
})(current, previous);
]]></script>
