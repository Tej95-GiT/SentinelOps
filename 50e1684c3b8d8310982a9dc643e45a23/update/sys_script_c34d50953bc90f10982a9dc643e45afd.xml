        <script><![CDATA[(function executeRule(current, previous) {

    gs.info('BR RUNNING');

    if (!current.assessment)
        return;

    var scorer = new ReadinessScorer();
    var result = scorer.calculateScore(current.assessment);

    var assessmentGR = new GlideRecord('x_1858206_sentin_0_readiness_assessment');

    if (assessmentGR.get(current.assessment)) {

        assessmentGR.criteria_total = result.total;
        assessmentGR.criteria_passed = result.passed;
        assessmentGR.readiness_score = result.score;
        assessmentGR.gate_result = result.gate;

        assessmentGR.update();

		gs.info('ASSESSMENT UPDATED');
    }

})(current, previous);]]></script>
